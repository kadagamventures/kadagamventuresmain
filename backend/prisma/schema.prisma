enum AgreementType {
  one_time
  monthly
  quarterly
  yearly
}

enum AgreementStatus {
  draft
  sent
  active
  expired
  terminated
}

model ServiceAgreement {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  agreementNumber String @unique

  agreementType AgreementType @default(one_time)

  startDate DateTime?
  endDate   DateTime?

  status AgreementStatus @default(draft)

  documentUrl String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailTracking AgreementEmailTracking?

  @@index([companyId])
  @@index([status])
}

model AgreementEmailTracking {
  id Int @id @default(autoincrement())

