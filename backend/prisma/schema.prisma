enum InvoiceType {
  Tax_Invoice
  Proforma_Invoice
}

enum InvoiceStatus {
  draft
  sent
  partial
  paid
  overdue
  cancelled
}

model Invoice {
  id Int @id @default(autoincrement())

  invoiceNumber String      @unique
  invoiceType   InvoiceType @default(Tax_Invoice)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceDate DateTime  @default(now())
  dueDate     DateTime?

  placeOfSupply String?

  status InvoiceStatus @default(draft)

  subTotal   Float @default(0)
  totalGST   Float @default(0)
  roundOff   Float @default(0)
  grandTotal Float @default(0)

  advanceAmount Float @default(0)
  totalPaid     Float @default(0)
  pendingAmount Float @default(0)

  amountInWords String?

  termsAndConditions String?

  pdfKey String?

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services      InvoiceService[]
  payments      InvoicePayment[]
  emailTracking EmailTracking?

  @@index([companyId])
  @@index([status])
  @@index([invoiceDate])
}

model InvoiceService {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  serviceName String
  description String?

  sacCode String?

  price    Float
  quantity Int   @default(1)

  gstRate Float @default(18)

  taxableAmount Float?

  cgst Float?

  sgst Float?

  igst Float?

  total Float?
}

model InvoicePayment {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Float

  paymentMethod String?

  transactionId String?

  paymentDate DateTime @default(now())

  notes String?
}

model EmailTracking {
  id Int @id @default(autoincrement())

  invoiceId Int     @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sent Boolean @default(false)

  sentCount Int @default(0)

  lastSentAt DateTime?

  history EmailHistory[]
}

model EmailHistory {
  id Int @id @default(autoincrement())

  emailTrackingId Int
  emailTracking   EmailTracking @relation(fields: [emailTrackingId], references: [id], onDelete: Cascade)

  sentAt DateTime?

  sentTo String?
}

