model BrandStrategyPricingPlan {
  id        Int      @id @default(autoincrement())
  planName  String
  priceFrom Float
  priceTo   Float
  duration  String?
  features  String[]
  isPopular Boolean  @default(false)

  brandStrategyIdentityId Int
  brandStrategyIdentity   BrandStrategyIdentity @relation(fields: [brandStrategyIdentityId], references: [id], onDelete: Cascade)
}

model BusinessSettings {
  id Int @id @default(autoincrement())

  businessName     String
  gstNumber        String?
  panNumber        String?
  cin              String?
  state            String?
  address          String?
  phone            String?
  email            String?
  logoUrl          String?
  signatureUrl     String?
  authorizedPerson String?

  invoicePrefix     String @default("INV")
  nextInvoiceNumber Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankDetails BankDetails?
}

model BankDetails {
  id Int @id @default(autoincrement())

  bankName      String?
  accountNumber String?
  ifscCode      String?
  branch        String?
  upiId         String?

  businessSettingsId Int              @unique
  businessSettings   BusinessSettings @relation(fields: [businessSettingsId], references: [id], onDelete: Cascade)
}

model Career {
  id Int @id @default(autoincrement())

  title          String
  location       String
  experience     String
  employmentType String
  overview       String

  responsibilities String[]
  skills           String[]

  whatWeOffer String[]
  howToApply  String?

  positionCount Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications CareerApplication[]
}

model CareerApplication {
  id Int @id @default(autoincrement())

  careerId Int
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  firstName String?
  lastName  String?

  email String

  phone    String?
  gender   String?
  location String?

  experience     String?
  currentSalary  String?
  expectedSalary String?
  noticePeriod   String?

  joiningDate       DateTime?
  joiningTime       String?
  isImmediateJoiner Boolean?

  resumeKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([careerId, email])
}

model Company {
  id Int @id @default(autoincrement())

  companyName        String
  legalName          String?
  gstNumber          String?
  panNumber          String?
  registrationNumber String?

  email   String?
  phone   String?
  website String?

  contactPersonName        String?
  contactPersonDesignation String?
  contactPersonPhone       String?
  contactPersonEmail       String?

  isDeleted Boolean @default(false)

  billingStreet  String?
  billingCity    String?
  billingState   String?
  billingCountry String? @default("India")
  billingPincode String?

  shippingStreet  String?
  shippingCity    String?
  shippingState   String?
  shippingCountry String? @default("India")
  shippingPincode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices          Invoice[]
  serviceAgreements ServiceAgreement[]
}

model CompanyUpdate {
  id Int @id @default(autoincrement())

  title   String
  message String

  pdfKey String?

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

