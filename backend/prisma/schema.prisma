// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BlogStatus {
  draft
  published
}

model Blog {
  id       Int     @id @default(autoincrement())
  title    String
  slug     String  @unique
  content  String
  excerpt  String?
  author   String
  category String

  tags String[]

  featuredImage String
  ogImage       String?

  isRecommended Boolean @default(false)

  status BlogStatus @default(draft)

  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandingGraphicDesign {
  id          Int      @id @default(autoincrement())
  title       String   @default("Branding & Graphic Design")
  slug        String   @unique @default("branding-graphic-design")
  description String
  platforms   String[]
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingPlans PricingPlan[]
}

model PricingPlan {
  id        Int      @id @default(autoincrement())
  planName  String
  priceFrom Float
  priceTo   Float
  duration  String?
  features  String[]
  isPopular Boolean  @default(false)

  brandingGraphicDesignId Int
  brandingGraphicDesign   BrandingGraphicDesign @relation(fields: [brandingGraphicDesignId], references: [id], onDelete: Cascade)
}

model BrandStrategyIdentity {
